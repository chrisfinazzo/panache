[ DefinitionList
    [ ( [ Str "Term" ]
      , [ [ Plain
              [ Str "definition"
              , Space
              , Str "text"
              , SoftBreak
              , RawInline (Format "html") "<embed src=\"x\">"
              , SoftBreak
              , Str "more"
              , Space
              , Str "text"
              ]
          ]
        ]
      )
    ]
]
