[ DefinitionList
    [ ( [ Str "Term" ]
      , [ [ Plain
              [ Str "definition"
              , Space
              , Str "text"
              , SoftBreak
              , RawInline (Format "html") "<button>"
              , Str "x"
              , RawInline (Format "html") "</button>"
              , SoftBreak
              , Str "more"
              , Space
              , Str "text"
              ]
          ]
        ]
      )
    ]
]
